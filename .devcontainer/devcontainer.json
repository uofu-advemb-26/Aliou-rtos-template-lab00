{
  "name": "C++ CMake Dev Container",
  "image": "://microsoft.com",
  "features": {
    "ghcr.io/devcontainers/features/git:1": {}
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cpptools",
        "ms-vscode.cmake-tools"
      ]
    }
  },
  "forwardPorts": [],
  "postCreateCommand": "git config --global --add safe.directory ${containerWorkspaceFolder}"
}
